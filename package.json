{
  "name": "playwright-enterprise-framework",
  "version": "0.1.0",
  "description": "Production-grade Playwright test framework: page objects, typed fixtures, UI + API layers, tagging, sharding, Docker and GitHub Actions.",
  "private": true,
  "license": "MIT",
  "author": "Yassine Ait Tamarmoucht",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yassineaitt/playwright-enterprise-framework.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "browsers:install": "playwright install --with-deps",
    "prepare": "husky"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "page-object",
    "api-testing",
    "e2e"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "zod": "^4.6.7"
  },
  "type": "module",
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
