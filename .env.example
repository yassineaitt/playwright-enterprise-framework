# Copy to .env for local overrides. CI uses defaults; no secrets are required.
BASE_URL=https://demo.playwright.dev/todomvc/
API_BASE_URL=https://restful-booker.herokuapp.com
# Demo credentials published by restful-booker (public sandbox, not a secret)
API_USERNAME=admin
API_PASSWORD=password123
# Set to 1 to run headed locally
HEADED=0
